SCAN_DIR=/var/www/
# Keyword (pisah koma, tidak case-sensitive) untuk menyembunyikan project dari semua user
# non-superadmin. Keyword per-user diatur di User Management.
HIDDEN_PROJECT_KEYWORDS=
# AI Chat (read-only Claude Code). Lihat docs/ai-chat-setup.md
# Path binary claude yang bisa dieksekusi user CHAT_USER (default: claude di PATH).
CLAUDE_BIN=
# User Linux tanpa hak tulis yang menjalankan claude, dan home-nya.
CHAT_USER=claude-ro
CHAT_HOME=/home/claude-ro
# Token dari `sudo -u claude-ro claude setup-token`. Jangan di-commit.
# CLAUDE_CODE_OAUTH_TOKEN=
# Model yang bisa dipilih di chat (alias CLI, pisah koma). Default: haiku,sonnet,opus
# CHAT_MODELS=haiku,sonnet,opus
# Folder tambahan yang boleh dicari Claude untuk superadmin (path absolut, pisah koma). Hak baca tetap ditentukan OS untuk claude-ro.
# CHAT_EXTRA_DIRS=/var/log,/home/zae
# Admin dan superadmin boleh menyuruh Claude menjalankan perintah, tiap perintah harus disetujui di chat.
# Syarat: monitor jalan sebagai root (Claude jalan sebagai claude-ro) dan bwrap terpasang (apt install bubblewrap).
# CHAT_SHELL=1
# Path node yang bisa dieksekusi claude-ro untuk menjalankan chat-mcp.js (default: node yang menjalankan monitor).
# CHAT_NODE=/usr/bin/node
# Admin dan superadmin boleh menyuruh Claude menjalankan "php artisan tinker" di project Laravel, tiap kode harus disetujui di chat.
# Monitor (root) yang menjalankannya sebagai CHAT_TINKER_USER, bukan Claude. Claude tidak pernah memegang kredensial database.
# CHAT_TINKER=1
# CHAT_TINKER_USER=www-data
# CHAT_PHP=/usr/bin/php

