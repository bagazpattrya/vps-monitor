SCAN_DIR=/var/www/
# Keyword (pisah koma, tidak case-sensitive) untuk menyembunyikan project dari semua user
# non-superadmin. Keyword per-user diatur di User Management.
HIDDEN_PROJECT_KEYWORDS=
# AI Chat (read-only Claude Code). Lihat docs/ai-chat-setup.md
# Path binary claude yang bisa dieksekusi user CHAT_USER (default: claude di PATH).
CLAUDE_BIN=
# User Linux tanpa hak tulis yang menjalankan claude, dan home-nya.
CHAT_USER=claude-ro
CHAT_HOME=/home/claude-ro
# Token dari `sudo -u claude-ro claude setup-token`. Jangan di-commit.
# CLAUDE_CODE_OAUTH_TOKEN=
# Model yang bisa dipilih di chat (alias CLI, pisah koma). Default: haiku,sonnet,opus
# CHAT_MODELS=haiku,sonnet,opus
